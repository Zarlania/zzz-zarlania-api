<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Exclude the generated/framework Spring Boot bootstrap class. -->
  <Match>
    <Class name="com.zarlania.api.ZarlaniaApiApplication"/>
  </Match>

  <!--
    FindSecBugs SPRING_ENDPOINT: informational audit detector that reports every
    @RestController as a "Found Spring endpoint." It identifies no actual
    vulnerability — only that the class is a controller. Suppressed here because
    the finding adds no actionable signal; security of individual endpoints is
    reviewed through integration tests and code review. See issue #48 (durable
    record for this exclusion). Related but distinct: issue #23 (CORS detector
    NPE on WebConfig, a different FindSecBugs detector-quality issue).
  -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>

  <!--
    FindSecBugs SERVLET_HEADER ("Request header can easily be altered by the client"):
    an informational taint-source detector that fires on every HttpServletRequest.getHeader()
    call — it flags the read itself, not a flow to a dangerous sink, so no downstream
    sanitization can remove it. TraceIdFilter deliberately treats these headers as untrusted:
    it validates the W3C `traceparent` and `X-Trace-Id` values against strict regex charsets
    and falls back to a generated UUID, so no unvalidated client value reaches the response
    header, the logging MDC, or the trace-decision cache key. That mitigation is proven by
    TraceIdFilterTest.rejectsUnsafeTraceIdAndGeneratesInstead (a CRLF payload is rejected and
    regenerated) and ignoresMalformedTraceparentAndGeneratesInstead. Scoped to TraceIdFilter
    only — NOT a global suppression — so any future code that reads request headers still gets
    flagged for a fresh validation review. Introduced with, and durably recorded by, issue #66
    (the trace-id filter). See also issue #48 (SPRING_ENDPOINT) for the same
    informational-detector exclusion pattern.
  -->
  <Match>
    <Class name="com.zarlania.api.web.TraceIdFilter"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>

</FindBugsFilter>
